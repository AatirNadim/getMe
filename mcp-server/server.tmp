{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.aatirnadim/getme-mcp-server",
  "title": "getMe MCP Server",
  "description": "An MCP server that exposes getMe key-value operations as MCP tools",
  "version": "1.2.3",
  "repository": {
    "url": "https://github.com/AatirNadim/getMe",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "getme-mcp-server",
      "version": "1.2.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GETME_SOCKET_PATH",
          "description": "Path to the UNIX socket for getMe core server",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "GETME_READ_ONLY",
          "description": "If true, only get and get_json tools are registered",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "GETME_ALLOW_CLEAR",
          "description": "If true, enables the dangerous clear tool",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "GETME_KEY_PREFIX",
          "description": "String prefix prepended to all keys (e.g. agent1:)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
